{
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=()"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    },
    {
      "source": "/panama-dive-center/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/favicon.svg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/svg+xml"
        }
      ]
    },
    {
      "source": "/logo.png",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    },
    {
      "source": "/logo.jpeg",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/jpeg"
        }
      ]
    },
    {
      "source": "/favicon.ico",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/x-icon"
        }
      ]
    },
    {
      "source": "/favicon-32x32.png",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    },
    {
      "source": "/apple-touch-icon.png",
      "headers": [
        {
          "key": "Content-Type",
          "value": "image/png"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/reprogramar/:e([A-Za-z0-9_-]+)",
      "destination": "https://source.thryvexgroup.com/widget/booking/Xk4R0IAoI7kfu7iGSHNw?event_id=:e",
      "permanent": false
    },
    {
      "source": "/reschedule/:e([A-Za-z0-9_-]+)",
      "destination": "https://source.thryvexgroup.com/widget/booking/GoaSvdUc3KUaJwvNIsMr?event_id=:e",
      "permanent": false
    },
    {
      "source": "/cancelar/:e([A-Za-z0-9_-]+)",
      "destination": "https://source.thryvexgroup.com/widget/cancel-booking?event_id=:e",
      "permanent": false
    },
    {
      "source": "/cancel/:e([A-Za-z0-9_-]+)",
      "destination": "https://source.thryvexgroup.com/widget/cancel-booking?event_id=:e",
      "permanent": false
    },
    {
      "source": "/reprogramar",
      "destination": "/book?lang=es",
      "permanent": false
    },
    {
      "source": "/reschedule",
      "destination": "/book",
      "permanent": false
    },
    {
      "source": "/cancelar",
      "destination": "/book?lang=es",
      "permanent": false
    },
    {
      "source": "/cancel",
      "destination": "/book",
      "permanent": false
    }
  ],
  "rewrites": [
    {
      "source": "/panama-dive-center",
      "destination": "/panama-dive-center/index.html"
    },
    {
      "source": "/panama-dive-center/",
      "destination": "/panama-dive-center/index.html"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/book",
      "destination": "/book.html"
    },
    {
      "source": "/book.html",
      "destination": "/book.html"
    },
    {
      "source": "/booked",
      "destination": "/booked.html"
    },
    {
      "source": "/booked.html",
      "destination": "/booked.html"
    },
    {
      "source": "/((?!api/)(?:[^.]+|.+\\.html)$)",
      "destination": "/index.html"
    }
  ]
}
